@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: decomposition-generator/generate_decomp.py
skinparam packageStyle rectangle

rectangle "generate_decomp.py" <<FileLevel>> as file_generate_decomp {
  rectangle "PythonMethodCallVisitor" <<ClassLevel>> as cls_PythonMethodCallVisitor {
    component "generate_decomp.py::<b>PythonMethodCallVisitor.__init__()</b>" <<FunctionLevel>> as m_1
    component "generate_decomp.py::<b>PythonMethodCallVisitor._function_has_value_return()</b>" <<FunctionLevel>> as m_2
    component "generate_decomp.py::<b>PythonMethodCallVisitor._visit_function()</b>" <<FunctionLevel>> as m_3
    component "generate_decomp.py::<b>PythonMethodCallVisitor.current_function()</b>" <<FunctionLevel>> as m_4
    component "generate_decomp.py::<b>PythonMethodCallVisitor.visit_AsyncFunctionDef()</b>" <<FunctionLevel>> as m_5
    component "generate_decomp.py::<b>PythonMethodCallVisitor.visit_Call()</b>" <<FunctionLevel>> as m_6
    component "generate_decomp.py::<b>PythonMethodCallVisitor.visit_ClassDef()</b>" <<FunctionLevel>> as m_7
    component "generate_decomp.py::<b>PythonMethodCallVisitor.visit_FunctionDef()</b>" <<FunctionLevel>> as m_8
  }
  rectangle "_ReturnValueVisitor" <<ClassLevel>> as cls__ReturnValueVisitor {
    component "generate_decomp.py::<b>_ReturnValueVisitor.__init__()</b>" <<FunctionLevel>> as m_9
    component "generate_decomp.py::<b>_ReturnValueVisitor.visit_AsyncFunctionDef()</b>" <<FunctionLevel>> as m_10
    component "generate_decomp.py::<b>_ReturnValueVisitor.visit_ClassDef()</b>" <<FunctionLevel>> as m_11
    component "generate_decomp.py::<b>_ReturnValueVisitor.visit_FunctionDef()</b>" <<FunctionLevel>> as m_12
