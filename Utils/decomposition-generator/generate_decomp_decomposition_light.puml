  }
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_generate_decomp {
    component "generate_decomp.py::<b>analyze_file()</b>" <<FunctionLevel>> as m_15
    component "generate_decomp.py::<b>analyze_java_source()</b>" <<FunctionLevel>> as m_16
    component "generate_decomp.py::<b>analyze_python_source()</b>" <<FunctionLevel>> as m_17
    component "generate_decomp.py::<b>attribute_chain_name()</b>" <<FunctionLevel>> as m_18
    component "generate_decomp.py::<b>build_puml()</b>" <<FunctionLevel>> as m_19
    component "generate_decomp.py::<b>class_names()</b>" <<FunctionLevel>> as m_20
    component "generate_decomp.py::<b>collect_source_files()</b>" <<FunctionLevel>> as m_21
    component "generate_decomp.py::<b>extract_calls()</b>" <<FunctionLevel>> as m_22
    component "generate_decomp.py::<b>extract_methods()</b>" <<FunctionLevel>> as m_23
    component "generate_decomp.py::<b>filter_method_calls()</b>" <<FunctionLevel>> as m_24
    component "generate_decomp.py::<b>find_matching_brace()</b>" <<FunctionLevel>> as m_25
    component "generate_decomp.py::<b>has_java_value_return()</b>" <<FunctionLevel>> as m_26
    component "generate_decomp.py::<b>is_probable_method_declaration()</b>" <<FunctionLevel>> as m_27
    component "generate_decomp.py::<b>load_theme_lines()</b>" <<FunctionLevel>> as m_28
    component "generate_decomp.py::<b>main()</b>" <<FunctionLevel>> as m_29
    component "generate_decomp.py::<b>sanitize_identifier()</b>" <<FunctionLevel>> as m_30
    component "generate_decomp.py::<b>simple_callable_name()</b>" <<FunctionLevel>> as m_31
    component "generate_decomp.py::<b>simple_name()</b>" <<FunctionLevel>> as m_32
    component "generate_decomp.py::<b>split_owner_and_method()</b>" <<FunctionLevel>> as m_33
    component "generate_decomp.py::<b>strip_comments_and_strings()</b>" <<FunctionLevel>> as m_34
    component "generate_decomp.py::<b>usage()</b>" <<FunctionLevel>> as m_35
    component "generate_decomp.py::<b>write_output()</b>" <<FunctionLevel>> as m_36
  }
}

